{
  // Type-checks the feasibility code (JS with JSDoc types; nothing is compiled): `npm run typecheck`.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["lib/feasibility/**/*.mjs", "lib/reports/feasibility.mjs", "api/feasibility.js", "scripts/*.mjs"]
}
