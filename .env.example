# Environment variables read by fs-real-estate-intelligence. Copy to .env for `npm run dev` (the dev server loads it;
# the shell wins) and set the same names on the Vercel project. Every name here belongs to this platform; nothing
# points at another app's deployment, database or storage. Leave a value empty to turn that feature off: each function
# says plainly what's missing instead of failing.

# ---------- Supabase (this platform's own project) ----------
SUPABASE_URL=                      # https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=               # server only: projects, team notes, Regrid counter, report-set storage
SUPABASE_SERVICE_ROLE_KEY=         # legacy name for the secret key (either works)
SUPABASE_PUBLISHABLE_KEY=          # browser read-only key, written to public/config.json at assemble
SUPABASE_ANON_KEY=                 # legacy name for the publishable key
NEXT_PUBLIC_SUPABASE_URL=          # alternative names some Vercel integrations set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
FIELD_ACCESS_CODE=                 # optional team passcode for projects and team notes

# ---------- Feasibility workspace (lib/feasibility, api/feasibility.js) ----------
REPORT_SETS_BUCKET=report-sets     # private Storage bucket for saved report sets (migration 20261026000000_report_sets.sql)
FEASIBILITY_NARRATIVE=off          # 'on' lets Claude write the report's plain-English summary (numbers always come from the engine)

# ---------- AI ----------
ANTHROPIC_API_KEY=                 # Claude: plan-set notes, building designs, feasibility narrative
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
PLANSET_MONTHLY_CAP_USD=100
OPENAI_API_KEY=                    # chat assistant, enrichment, renderings, voice
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_CHAT_MODEL=
OPENAI_CHAT_REASONING_EFFORT=
OPENAI_ENRICH_MODEL=
OPENAI_SEARCH_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_VOICE=
OPENAI_IMAGE_MODEL=
OPENAI_ADMIN_KEY=                  # optional: usage/cost readout
OPENAI_PROJECT_ID=
OPENAI_API_KEY_ID=
VOICE_ENABLED=
RENDER_MONTHLY_CAP_USD=100
RENDER_FALLBACK_USD_PER_IMAGE=
AI_PROXY_URL=                      # nightly data workflow: this deployment's /api/pipeline-ai

# ---------- Parcels, maps and data providers ----------
REGRID_API_KEY=                    # paid parcels (capped below); REGRID_TOKEN is accepted too
REGRID_TOKEN=
REGRID_RECORD_CAP=1800
REGRID_TILE_CAP=180000
REGRID_TILE_URL=
PARCEL_SERVICE=
ADDRESS_POINTS_SERVICE=
MAPTILER_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_AUTOCOMPLETE_CAP=
GOOGLE_DETAILS_CAP=
TOMTOM_API_KEY=
MAPILLARY_TOKEN=
OPEN_METEO_API_KEY=
CENSUS_KEY=
BLS_KEY=
BLS_API_KEY=
GOV_API_KEY=
FBI_API_KEY=
SOCRATA_APP_TOKEN=
HF_TOKEN=
OVERPASS_URL=

# ---------- Access, cron, outbound ----------
MCP_ACCESS_TOKEN=                  # bearer token for /api/mcp (open when empty)
CRON_SECRET=
ZAPIER_DIGEST_WEBHOOK=             # this platform's own optional digest hook

# ---------- PDF ----------
CHROME_PATH=                       # local Chrome/Chromium for PDFs and tests (Vercel uses @sparticuz/chromium)

# ---------- Local dev server (scripts/dev.mjs) ----------
PORT=8787
HOST=127.0.0.1

# ---------- Nightly data build (build.mjs; GitHub Actions) ----------
DATA_DIR=
ONLY=
PERIOD_START=
PERIOD_END=
ALLOW_SHRINK=
AI_MAX_ROWS=
AI_CONCURRENCY=
AREA=
AREA_NEWS_TOWNS=
REBUILD_AREA=
REBUILD_GEO=
REBUILD_MARKET=
REBUILD_RISK=
REBUILD_SPENDING=
REBUILD_USCO=
# (the build has further one-off knobs: see README "How the data works")
