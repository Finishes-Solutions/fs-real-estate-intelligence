+// Offline tests for split detention, the low side, trails and sidewalks (lib/detention.mjs, lib/trails.mjs and the
+// sidewalks and ponds in lib/siteplan.mjs; NEIGHBORHOOD-PLAN.md phase 5) on realistic sites: the 246-acre Waller tract
+// (a subdivision, with and without the low side at its south-east corner), the 110-acre pentagon round a commons lake,
+// the 101-acre mixed site in pods (shops, homes and a lake commons), a 32-acre neighbourhood on straight streets and the
+// narrow 50-acre tract with a heavy storage rate. The detention is met across the ponds or the plan says by how much
+// it's short; the ponds sit nearest the low side with the outfall drawn to it (and where they always did without one);
+// every pond has its trail and the trails reach the sidewalks (or say they don't) without crossing a lot or a home;
+// sidewalks run along every street, never over a lot, a home or another street; Change With AI's trail, connect, split,
+// low side and sidewalk edits; re-fits keep it all. Slow-ish (about two minutes): the big sites are laid out once each.
+import assert from 'node:assert/strict';
+const S = await import('../lib/siteplan.mjs'), L = await import('../lib/sitelayout.mjs'), E = await import('../lib/siteedit.mjs'), G = await import('../lib/sitesheet.mjs'), D = await import('../lib/detention.mjs'), T = await import('../lib/trails.mjs'), PF = await import('../lib/proforma.mjs');
+
+const mk = (o, pts) => { const k = 364567 * Math.cos(o[1] * Math.PI / 180); return { type: 'Polygon', coordinates: [pts.concat([pts[0]]).map(([x, y]) => [o[0] + x / k, o[1] + y / 364567])] }; };
+const edge = (b, f) => b.ring.findIndex((p, i) => f(S.outwardOf(b.ring, i)));
+const W0 = S.unionParcels([mk([-95.93, 30.06], [[0, 0], [3400, 0], [3400, 2400], [2300, 3300], [0, 3300]])]), waller = { ...W0, front: edge(W0, n => n[1] < -0.9), setbacks: { ...S.SETBACKS } };
+const P0 = S.unionParcels([mk([-95.97, 30.07], [[-610, 0], [1933, 0], [2594, 865], [2391, 1780], [0, 1780]])]), pentagon = { ...P0, front: edge(P0, n => n[1] < -0.9), setbacks: { ...S.SETBACKS } };
+const N0 = S.unionParcels([mk([-95.80, 29.95], [[0, 0], [660, 0], [700, 3200], [20, 3250]])]), narrow = { ...N0, front: edge(N0, n => n[1] < -0.9), setbacks: { ...S.SETBACKS } };
+const M0 = S.unionParcels([mk([-95.96, 30.07], [[0, 0], [2600, 0], [2600, 1700], [0, 1700]])]), mixed = { ...M0, front: edge(M0, n => n[1] < -0.9), setbacks: { ...S.SETBACKS } };
+const straight = { origin: [-95.93, 30.09], ring: [[-700, -500], [700, -500], [700, 500], [-700, 500]], front: 0, setbacks: { ...S.SETBACKS }, params: { streets: 'straight' } };
+const commons = { use: 'mixed', zones: [{ use: 'sfr' }, { use: 'amenity', items: ['lake', 'center', 'pool', 'playground'] }] };
+
+const dist = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]), ccw = r => S.signedArea(r) >= 0 ? r : r.slice().reverse(), lenOf = P => P.reduce((t, q, i) => i ? t + dist(q, P[i - 1]) : 0, 0);
+const box = s => { const xs = s.map(p => p[0]), ys = s.map(p => p[1]); return [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)]; };
+const diag = site => { const b = box(site.ring); return Math.hypot(b[2] - b[0], b[3] - b[1]); };
+const low = (site, w) => ({ ...site, low: { hand: { at: S.lowAt(site, w), how: 'words', words: w } } });
+const homes = els => els.filter(e => e.kind === 'building' && ['sfr', 'duplex', 'townhomes'].includes(e.use)).length;
+const asPlan = (site, o) => ({ ...site, program: o.program, elements: o.elements, recipe: o.recipe, notes: o.notes || [] });
+const times = {}, timed = (k, f) => { const t0 = Date.now(), r = f(); times[k] = Date.now() - t0; return r; };
+// a subdivision (its own streets, one network kind or the best), the post-pass on it as New Layouts runs it
+const net = (site, prog, ms = 6000, kinds = null) => { const o = L.netOnly(site, prog, { count: 1, netBudgetMs: ms, ...(kinds ? { netKinds: kinds } : {}) })[0]; assert.ok(o, 'a subdivision on the site'); return asPlan(site, L.waterWalks(site, o)); };
+const lay = (site, prog) => { const o = L.layoutOptions(site, prog, { count: 1 })[0]; assert.ok(o?.elements.length, 'a layout'); return asPlan(site, o); };
+const pods = (site, prog) => { const o = L.podsOnly(site, prog, { count: 1 })[0]; assert.ok(o, 'a layout in pods'); return asPlan(site, L.waterWalks(site, o)); };
+
+// how much of a pond its trail goes round (1: all the way); trails over lots, homes, ponds or streets (a link's ends meet
+// what it joins)
+const ringCover = (els, p) => { const c = S.centroid(S.outline(p)), per = lenOf(S.outline(p).concat([S.outline(p)[0]])), R = els.filter(t => t.kind === 'trail' && (t.of === p.id || t.closed && t.path?.length > 2 && S.inRing(c, t.path))); return R.some(t => t.closed) ? 1 : R.reduce((s, t) => s + lenOf(t.path), 0) / per; };
+const trailHits = (els, what) => { const hit = ['lot', 'building', 'garage', 'pond', 'pool', 'court', 'parking', 'drive'], G0 = S.gridIndex(els.filter(e => hit.includes(e.kind)), e => box(S.shapeOf(e)), 60), out = [];
+  for (const t of els.filter(e => e.kind === 'trail' && e.path?.length >= 2)) { const h = (t.width || 6) / 2 - 0.5, P = t.closed ? t.path.concat([t.path[0]]) : t.path, L0 = lenOf(P); let s = 0;
+    for (let i = 1; i < P.length; i++) { const a = P[i - 1], b = P[i], l = dist(a, b); for (let k = 0; k <= l; k += 3) { const q = [a[0] + (b[0] - a[0]) * k / (l || 1), a[1] + (b[1] - a[1]) * k / (l || 1)], at = s + k; if (!t.closed && (at < 8 || at > L0 - 8)) continue; // (an open trail's ends meet what it joins: a street's curb, a walk)
+      for (const o of G0.near(q[0] - h, q[1] - h, q[0] + h, q[1] + h)) { const r = S.shapeOf(o); if (S.inRing(q, r) || Math.min(...r.map((v, j) => S.segDist(q, v, r[(j + 1) % r.length]))) < h) { out.push(what + ': ' + (t.note || 'trail') + ' over ' + (o.name || o.kind)); break; } } } s += l; } }
+  return [...new Set(out)]; };
+// ---- the fixtures, laid out once each ----
+const W = timed('Waller', () => net(waller, { use: 'sfr' })), WL = timed('Waller · low side', () => net(low(waller, 'south-east'), { use: 'sfr' }));
+const PC = timed('pentagon commons · low side', () => net(low(pentagon, 'south-east'), commons, 8000, ['core']));
+const MX = timed('101 ac pods · low side', () => pods(low(mixed, 'south-east'), { use: 'mixed', zones: [{ use: 'retail', gfa: 60000 }, { use: 'sfr', units: 150 }, { use: 'amenity', items: ['lake', 'center', 'pool', 'playground'] }] }));
+const ST = timed('straight', () => lay(straight, { use: 'sfr' })), STL = timed('straight · low side', () => lay(low(straight, 'south-west'), { use: 'sfr' }));
+console.log('laid out (ms): ' + Object.entries(times).map(([k, v]) => k + ' ' + v).join(', '));
+const all = { Waller: W, 'Waller low': WL, 'pentagon commons': PC, '101 pods': MX, straight: ST, 'straight low': STL };
+
+// ---- 1. detention met across split ponds ----
+const met = (p, what) => { const st = S.stormOf(p), P = st.ponds; assert.ok(st.volume > 0, what + ': detention needed');
+  assert.ok(Math.abs(P.reduce((t, q) => t + q.share, 0) - st.held / st.volume) <= 0.01, what + ': the shares add up to what the ponds hold');
+  for (const q of P) assert.ok(q.sf >= 8000 || what === 'straight', what + ': ' + q.name + ' ' + Math.round(q.sf) + ' sf');
+  if (st.held >= st.volume * 0.95) return st; const line = p.notes.find(t => /^Ponds hold .* goes in underground storage\.$/.test(t)); assert.ok(line, what + ': short, and the plan says by how much');
+  const [h, v, , k] = line.match(/[\d.]+/g).map(Number); assert.ok(Math.abs(h - st.held) <= 0.1 && Math.abs(v - st.volume) <= 0.1 && Math.abs(k - st.vault) <= 0.1, what + ': its numbers are the plan’s: ' + line); return st; };
+for (const [k, p] of Object.entries(all)) met(p, k);
