{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node build.mjs --assemble",
  "outputDirectory": "public",
  "functions": {
    "api/brief.js": {
      "maxDuration": 60,
      "includeFiles": "data/{filings,changes,market,area}.json"
    },
    "api/feed.js": {
      "maxDuration": 10,
      "includeFiles": "data/{filings,changes}.json"
    },
    "api/building.js": {
      "maxDuration": 30
    },
    "api/pipeline-ai.js": {
      "maxDuration": 300
    },
    "api/chat.js": {
      "maxDuration": 120
    },
    "api/regrid.js": {
      "maxDuration": 20
    },
    "api/search.js": {
      "maxDuration": 60
    },
    "api/realtime.js": {
      "maxDuration": 15
    },
    "api/drive.js": {
      "maxDuration": 20
    },
    "api/isochrone.js": {
      "maxDuration": 40
    },
    "api/airports.js": {
      "maxDuration": 50
    },
    "api/tile.js": {
      "maxDuration": 10
    },
    "api/weather.js": {
      "maxDuration": 15
    },
    "api/news.js": {
      "maxDuration": 20
    },
    "api/nearby.js": {
      "maxDuration": 45
    },
    "api/field.js": {
      "maxDuration": 30
    },
    "api/imagery.js": {
      "maxDuration": 25
    },
    "api/planes.js": {
      "maxDuration": 15
    },
    "api/planes-sample.js": {
      "maxDuration": 30
    },
    "api/site.js": {
      "maxDuration": 25
    },
    "api/crime.js": {
      "maxDuration": 30
    },
    "api/fema.js": {
      "maxDuration": 90
    },
    "api/traffic.js": {
      "maxDuration": 30
    },
    "api/counties.js": {
      "maxDuration": 25
    },
    "api/pdf.js": {
      "maxDuration": 60,
      "includeFiles": "{fonts/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/markets.js": {
      "maxDuration": 20
    },
    "api/places.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/planes-sample",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, must-revalidate"
        }
      ]
    }
  ]
}
